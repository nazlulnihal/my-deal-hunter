# =============================================================================
# AUTONOMOUS AI SHOPPING INTELLIGENCE & DEAL SNIPER — ENVIRONMENT CONFIGURATION
# Never commit real API keys, passwords, or Telegram tokens to version control.
# Copy this file to `.env` and populate your secrets before starting the stack.
# =============================================================================

# --- Core Regional & Currency Settings ---
SNIPER_COUNTRY=AU
SNIPER_CURRENCY=AUD
SNIPER_DEFAULT_POSTCODES=2150,2000,2121

# --- Database Persistence (SQLite by default, PostgreSQL-compatible) ---
SNIPER_DB_PATH=./data/sniper_intelligence.db
# Optional PostgreSQL DSN for multi-node scale-out:
# DATABASE_URL=postgresql+psycopg2://sniper_user:change_me@postgres:5432/sniper_db

# --- Background Monitoring Worker & Rate Limiting ---
SNIPER_WORKER_TICK_SECONDS=60
SNIPER_ENGINE_A_HIGH_PRIORITY_MINS=5
SNIPER_ENGINE_A_STANDARD_MINS=15
SNIPER_ENGINE_B_DISCOVERY_MINS=10
SNIPER_MAX_REQUESTS_PER_DOMAIN_RPM=12

# --- Notification Thresholds & Quiet Hours ---
SNIPER_MIN_DEAL_SCORE_WISHLIST=70
SNIPER_MIN_DEAL_SCORE_OUTSIDE=90
SNIPER_QUIET_HOURS_START=22:30
SNIPER_QUIET_HOURS_END=07:00
SNIPER_DAILY_SUMMARY_TIME=08:00

# --- Telegram Bot API Integration (Primary Notification Channel) ---
# Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
# Message your bot and inspect getUpdates to obtain your numeric TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=

# --- AI Provider Configuration (Local-First / Zero-Recurring-Cost Default) ---
# Options: local_ollama | gemini_free_tier | openai_compatible
SNIPER_AI_PROVIDER=local_ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Optional Retailer API Credentials ---
AMAZON_AU_PAAPI_ACCESS_KEY=
AMAZON_AU_PAAPI_SECRET_KEY=
AMAZON_AU_PARTNER_TAG=
EBAY_AU_APP_ID=
EBAY_AU_CERT_ID=

# --- Dashboard Security ---
# Leave blank for local single-user mode, or set a strong token to require X-Sniper-Token header
SNIPER_DASHBOARD_TOKEN=
